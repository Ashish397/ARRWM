# Heavyweight working directories — never belong in the repo.
#   * noise_model/ : model weights + caches (~2.6 GB)
#   * vis/         : rendered visualisation outputs (~611 MB)
#   * eval/        : saved eval videos / diagnostics (~3.2 GB, grows)
noise_model/
vis/
eval/
_diag_p1/heatmap/
_diag_p1/out/
_diag_p1/out_frames/
_diag_p1/diag_streaming_logs.zip

# Test artefacts (outputs only — the .py test scripts *are* tracked).
# ``testing/outputs/`` is an mp4 dumping ground; the individual ignore
# patterns below also catch stray renders that end up elsewhere inside
# testing/ (e.g. under testing/motion_habitat_out/).
testing/outputs/
testing/**/*.mp4

# Third-party upstream clones vendored at repo root. Each of these has
# its own ``.git/``, so leaving them untracked risks a future
# ``git add .`` creating broken gitlinks. They are not maintained as
# submodules intentionally; re-clone from upstream if you need them.
references/
CausVid/
# Causal Forcing (upstream clone / vendored) — all common path spellings
Causal-Forcing/
Causal-Forcing-v2/
causal-forcing/
Causal_Forcing/
causal_forcing/
RollingForcing/
LongLive/
Nitro-1/
Reward-Forcing/
Self-Forcing-Plus-Plus/
sam2_checkpoints/
guided-diffusion/
# Editor / tooling scratch.
*.bak
papers/

pav.txt
*.pt

# Heavyweight untracked working dirs — hundreds of GB of model weights,
# checkpoints, and rendered outputs. Staging these makes ``git add`` hash
# ~581 GB and hang; never belong in the repo.
third_party/
analysis/
# Local-only working directories (not present on remote but contain
# investigation outputs we want to keep)
brightness_shifts/
warping/

# grids/: commit the eval scripts/tables/results only. The generic eval/
# rule above also catches grids/eval (a code dir), so re-include it, then
# exclude all heavy video, zips, python envs, cloned repos, tiles, weights.
!grids/eval/
grids/*.zip
